# ─── Entorno ────────────────────────────────────────────────
NODE_ENV=development
SERVICE_APP_NAME=schemify-microservice-dev

# ─── gRPC ───────────────────────────────────────────────────
SERVICE_PORT=50051
SERVICE_GRPC_URL=0.0.0.0:50051
SERVICE_GRPC_PROTO_PATH=proto/src/services/

# ─── Base de datos PostgreSQL ───────────────────────────────
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=schemifydb_dev

DATABASE_URL=postgresql://devuser:devpass@postgres:5432/schemifydb_dev
