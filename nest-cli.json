{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/schemify-microservice/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/schemify-microservice",
  "projects": {
    "observability": {
      "type": "library",
      "root": "libs/observability",
      "entryFile": "index",
      "sourceRoot": "libs/observability/src",
      "compilerOptions": {
        "tsConfigPath": "libs/observability/tsconfig.lib.json"
      }
    },
    "proto": {
      "type": "library",
      "root": "libs/proto",
      "sourceRoot": "libs/proto",
      "compilerOptions": {
        "tsConfigPath": "libs/proto/tsconfig.lib.json",
        "webpack": false,
        "assets": [
          "src/**/*.proto"
        ],
        "watchAssets": true
      }
    },
    "schemify-microservice": {
      "type": "application",
      "root": "apps/schemify-microservice",
      "entryFile": "src/main",
      "sourceRoot": "./",
      "compilerOptions": {
        "tsConfigPath": "apps/schemify-microservice/tsconfig.app.json",
        "assets": [
          "libs/proto/src/*.proto"
        ],
        "watchAssets": true
      }
    }
  }
}